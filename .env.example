# Copy these into Vercel Project Settings > Environment Variables.
# Never commit real credentials.
AI_API_KEY=
AI_MODEL=
# Optional. Defaults to https://api.openai.com/v1
AI_BASE_URL=
# Optional exact browser origin for future Back Office web app.
ROBOT_ALLOWED_ORIGIN=

# Azure Speech text-to-speech (Indonesian male voice).
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Optional; defaults to id-ID-ArdiNeural.
AZURE_SPEECH_VOICE=id-ID-ArdiNeural
